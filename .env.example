# ═══════════════════════════════════════════════════════════
#  Hermes Agent — Environment Variables
#  Copy to .env or export directly. See the real .env for examples.
#  NOTE: The app does NOT auto-load .env files — export first:
#    git-bash:   set -a; source .env; set +a
#    PowerShell: Get-Content .env | Where-Object {$_ -notmatch '^\s*#'} | ForEach-Object { $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k.Trim(), $v.Trim(), 'Process') }
# ═══════════════════════════════════════════════════════════

# ── LLM Provider (Z.ai / GLM) ─────────────────────────────
# With prefix "HERMES_" and .NET env __ → : mapping, the full
# config section path must be included (Hermes:Llm:*).
HERMES_Hermes__Llm__Provider=custom
HERMES_Hermes__Llm__Model=glm-5.1
HERMES_Hermes__Llm__BaseUrl=https://api.z.ai/api/paas/v4
HERMES_Hermes__Llm__ApiKey=PUT_YOUR_ZAI_KEY_HERE

# ── Alternative: OpenRouter ───────────────────────────────
# HERMES_Hermes__Llm__Provider=openrouter
# HERMES_Hermes__Llm__Model=openai/gpt-4o
# HERMES_Hermes__Llm__ApiKey=sk-or-...

# ── Agent tuning ───────────────────────────────────────────
HERMES_Hermes__Agent__MaxTurns=50
HERMES_Hermes__Agent__EnableSkillNudging=true